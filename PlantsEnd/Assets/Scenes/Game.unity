    m_MaxSize: 64
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.63
  m_Text: "\u0413\u043D\u0438\u043B\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E.\n\n\u041A\u0430\u043A
    \u0431\u044B \u044D\u0442\u043E \u043D\u0435 \u0431\u044B\u043B\u043E \u043F\u0435\u0447\u0430\u043B\u044C\u043D\u043E,
    \u0442\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u043B\u0438\u0448\u043D\u0438\u0439
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442 \u0432 \u0432\u0430\u0448\u0435\u043C
    \u0441\u0430\u0434\u0443. \u042D\u0442\u0430 \u0433\u043D\u0438\u043B\u044C \u0431\u0443\u0434\u0435\u0442
    \u0441\u0442\u043E\u044F\u0442\u044C \u0442\u0443\u0442, \u043F\u043E\u043A\u0430
    \u0432\u044B \u043D\u0435 \u0440\u0435\u0448\u0438\u0442\u0435, \u043A\u0442\u043E
    \u0431\u0443\u0434\u0435\u0442 \u0435\u0435 \u0440\u0443\u0431\u0438\u0442\u044C.
    \u041F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435
    \u0435\u0439 \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0442\u043E\u043F\u0438\u0442\u044C
    \u043F\u0435\u0447\u043A\u0443."
