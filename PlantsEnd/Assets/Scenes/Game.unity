  m_FontData:
    m_Font: {fileID: 12800000, guid: b0854e4c47ddf674f93bc16d0541245f, type: 3}
    m_FontSize: 43
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 64
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.63
  m_Text: "\u0424\u0440\u0443\u043A\u0442\n\n\u041A\u0430\u043A\u043E\u0439-\u0442\u043E
    \u0444\u0440\u0443\u043A\u0442. \u041F\u043E \u0444\u043E\u0440\u043C\u0435 \u043E\u043D
    \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0442\u044C
    \u0447\u0442\u043E \u0443\u0433\u043E\u0434\u043D\u043E, \u0434\u0430\u0436\u0435
    \u044F\u0433\u043E\u0434\u0443 \u0438\u043B\u0438 \u043E\u0432\u043E\u0449, \u043E\u043D
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u0430\u0436\u0435
    \u0443\u0436\u0435 \u0432 \u043D\u0430\u0440\u0435\u0437\u0430\u043D\u043E\u043C
    \u0432\u0438\u0434\u0435, \u043D\u043E \u0440\u0430\u0437 \u043E\u043D \u0440\u0430\u0441\u0442\u0435\u0442
    \u043D\u0430 \u0444\u0440\u0443\u043A\u0442\u043E\u0432\u043E\u043C \u0434\u0435\u0440\u0435\u0432\u0435
    - \u044D\u0442\u043E \u0444\u0440\u0443\u043A\u0442."
