    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.63
  m_Text: "\u0414\u0435\u0440\u0435\u0432\u043E\n\n\u0411\u043E\u043B\u044C\u0448\u0435
    \u0431\u0435\u0437 \u0442\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u044C
    \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F. \u041D\u043E
    \u0442\u043E, \u0447\u0442\u043E \u043E\u043D\u043E \u0435\u0441\u0442\u044C
    - \u0443\u0436\u0435 \u0445\u043E\u0440\u043E\u0448\u043E. \u041E\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0434\u0435\u044F\u0442\u0441\u044F,
    \u0447\u0442\u043E 10 \u043C\u043E\u043D\u0435\u0442 \u0431\u044B\u043B\u0438
    \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0442\u0430\u043A."
