    m_LineSpacing: 0.63
  m_Text: "\u0422\u0440\u0430\u0432\u0430\n\n\u041E\u0431\u044B\u0447\u043D\u0430\u044F
    \u0442\u0440\u0430\u0432\u0430, \u043C\u043E\u0436\u043D\u043E \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C
    \u043A\u043B\u0438\u043A\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
    \u043C\u0435\u0448\u0430\u043B\u0430\u0441\u044C. \u0412 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
    \u0431\u043E\u043D\u0443\u0441\u0430 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
    \u043C\u043D\u043E\u0433\u043E\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043D\u0430\u0434\u043F\u0438\u0441\u044C \"+0 \u043C\u043E\u043D\u0435\u0442\"."
